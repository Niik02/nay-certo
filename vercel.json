{
  "images": {
    "sizes":,
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 60
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=60"
        }
      ]
    }
  ]
}
